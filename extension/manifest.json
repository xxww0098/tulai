{
  "manifest_version": 3,
  "name": "xbs 页面桥",
  "version": "0.3.4",
  "description": "把本机 xbs 的图生图命令转到通义 / 千问或豆包页面：上传、填词、发送、等待和下载。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "downloads",
    "windows"
  ],
  "host_permissions": [
    "https://www.tongyi.com/*",
    "https://*.tongyi.com/*",
    "https://tongyi.com/*",
    "https://www.qianwen.com/*",
    "https://*.qianwen.com/*",
    "https://qianwen.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://qwen.ai/*",
    "https://www.doubao.com/*",
    "https://*.doubao.com/*",
    "https://doubao.com/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tongyi.com/*",
        "https://*.tongyi.com/*",
        "https://tongyi.com/*",
        "https://www.qianwen.com/*",
        "https://*.qianwen.com/*",
        "https://qianwen.com/*",
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*",
        "https://qwen.ai/*"
      ],
      "js": [
        "qianwen/chooser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tongyi.com/*",
        "https://*.tongyi.com/*",
        "https://tongyi.com/*",
        "https://www.qianwen.com/*",
        "https://*.qianwen.com/*",
        "https://qianwen.com/*",
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*",
        "https://qwen.ai/*"
      ],
      "js": [
        "protocol.js",
        "qianwen/page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://*.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": [
        "protocol.js",
        "doubao/page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "xbs 页面桥"
  }
}
