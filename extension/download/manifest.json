{
  "manifest_version": 2,
  "name": "Media Helper",
  "version": "0.1.0",
  "description": "Collect and save page media items.",
  "browser_specific_settings": { "gecko": { "id": "{00000000-0000-4000-8000-000000000002}" } },
  "permissions": ["tabs", "http://127.0.0.1/*"],
  "background": { "scripts": ["settings.js", "background.js"] },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["temu.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
